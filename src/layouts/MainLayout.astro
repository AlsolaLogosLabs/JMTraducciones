---
import "../styles/global.css";

import { contact } from "../data/contact";
import { profile } from "../data/profile";
import {
  defaultLocale,
  getAbsoluteHomeURL,
  localeSettings,
  locales,
  type Locale,
} from "../i18n/config";
import { getContent } from "../i18n/content";

interface Props {
  locale?: Locale;
  title: string;
  description?: string;
  // Páginas de error: no se indexan, no declaran URL canónica ni datos estructurados.
  noindex?: boolean;
  // URLs absolutas de la página equivalente en cada idioma: añade hreflang y og:locale:alternate.
  alternateURLs?: Record<Locale, string>;
}

const {
  locale = defaultLocale,
  title,
  description = getContent(locale).seo.description,
  noindex = false,
  alternateURLs,
} = Astro.props;

const t = getContent(locale);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const baseURL = import.meta.env.BASE_URL;

const homeURL = getAbsoluteHomeURL(locale);

// Identificadores estables, comunes a todos los idiomas: ES y EN describen la misma entidad.
const schemaBaseURL = getAbsoluteHomeURL(defaultLocale);

const ogImageURL = new URL(`${baseURL}${localeSettings[locale].ogImage}`, Astro.site);

const socialImageAlt = t.seo.socialImageAlt;

const alternateLocales = locales.filter((option) => option !== locale);

// Servicio profesional privado. La credencial se describe tal como consta en la
// documentación oficial, sin presentar a JM Traducciones como entidad gubernamental.
const businessSchema = {
  "@context": "https://schema.org",

  "@type": "ProfessionalService",

  "@id": `${schemaBaseURL}#business`,

  name: profile.brand,

  // Descripción del negocio, no de la página concreta (en la landing coinciden).
  description: t.seo.description,

  url: homeURL,

  image: ogImageURL.href,

  telephone: contact.whatsapp.phone,

  email: contact.email.address,

  sameAs: [contact.instagram.url],

  areaServed: {
    "@type": "Country",
    name: t.profile.location,
  },

  address: {
    "@type": "PostalAddress",
    addressCountry: "PA",
  },

  knowsLanguage: ["es", "en"],

  member: {
    "@type": "Person",

    "@id": `${schemaBaseURL}#translator`,

    name: profile.name,

    jobTitle: t.profile.role,

    knowsLanguage: ["en", "es"],

    hasCredential: {
      "@type": "EducationalOccupationalCredential",

      name: `${t.profile.role} (${t.profile.languages.source} - ${t.profile.languages.target})`,

      credentialCategory: t.seo.credentialCategory,

      dateCreated: String(profile.authorizedSince),

      recognizedBy: {
        "@type": "GovernmentOrganization",
        name: t.profile.authority,
      },
    },
  },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta name="description" content={description} />

    <meta name="author" content={profile.brand} />

    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    <meta name="theme-color" content="#174c4f" />

    <meta name="generator" content={Astro.generator} />

    {!noindex && <link rel="canonical" href={canonicalURL} />}

    {alternateURLs &&
      locales.map((option) => (
        <link rel="alternate" hreflang={option} href={alternateURLs[option]} />
      ))}

    {alternateURLs && (
      <link rel="alternate" hreflang="x-default" href={alternateURLs[defaultLocale]} />
    )}

    <link rel="sitemap" href={`${baseURL}sitemap-index.xml`} />

    <link rel="icon" type="image/svg+xml" href={`${baseURL}favicon.svg`} />

    <link rel="icon" href={`${baseURL}favicon.ico`} sizes="64x64" />

    <link rel="apple-touch-icon" href={`${baseURL}apple-touch-icon.png`} />

    <meta property="og:type" content="website" />

    <meta property="og:locale" content={localeSettings[locale].ogLocale} />

    {alternateURLs &&
      alternateLocales.map((option) => (
        <meta property="og:locale:alternate" content={localeSettings[option].ogLocale} />
      ))}

    <meta property="og:title" content={title} />

    <meta property="og:description" content={description} />

    {!noindex && <meta property="og:url" content={canonicalURL} />}

    <meta property="og:site_name" content={profile.brand} />

    <meta property="og:image" content={ogImageURL} />

    <meta property="og:image:type" content="image/png" />

    <meta property="og:image:width" content="1200" />

    <meta property="og:image:height" content="630" />

    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />

    <meta name="twitter:title" content={title} />

    <meta name="twitter:description" content={description} />

    <meta name="twitter:image" content={ogImageURL} />

    <meta name="twitter:image:alt" content={socialImageAlt} />

    {!noindex && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(businessSchema)}
      ></script>
    )}
  </head>

  <body>
    <slot />
  </body>
</html>
