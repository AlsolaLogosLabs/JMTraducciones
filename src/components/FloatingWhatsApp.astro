---
import Icon from "./ui/Icon.astro";

import { defaultLocale, type Locale } from "../i18n/config";
import { getContent, getWhatsAppURLs } from "../i18n/content";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;

const t = getContent(locale);
---

<a
  class="floating-whatsapp"
  href={getWhatsAppURLs(locale).quote}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t.floatingWhatsApp.label}
>
  <Icon name="whatsapp" size={26} />
</a>

<style>
  .floating-whatsapp {
    position: fixed;

    right: calc(1rem + env(safe-area-inset-right));
    bottom: calc(1rem + env(safe-area-inset-bottom));

    z-index: 90;

    width: 56px;
    height: 56px;

    display: none;
    place-items: center;

    border: 2px solid var(--color-background);

    border-radius: 50%;

    color: var(--color-text-inverse);

    background: var(--color-primary);

    box-shadow: var(--shadow-lg);

    transition: background-color var(--transition-fast);
  }

  .floating-whatsapp:hover {
    background: var(--color-primary-hover);
  }

  /* Anillo doble: visible tanto sobre secciones claras como sobre las oscuras. */
  .floating-whatsapp:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;

    box-shadow:
      0 0 0 7px var(--color-primary-hover),
      var(--shadow-lg);
  }

  /* En escritorio el Header ya muestra el CTA de WhatsApp. */
  @media (max-width: 1080px) {
    .floating-whatsapp {
      display: grid;
    }
  }
</style>
