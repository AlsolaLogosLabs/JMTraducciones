---
import MainLayout from "../layouts/MainLayout.astro";

import Header from "./Header.astro";
import Process from "./Process.astro";
import Footer from "./Footer.astro";
import FloatingWhatsApp from "./FloatingWhatsApp.astro";
import Icon from "./ui/Icon.astro";
import TranslatorStatement from "./ui/TranslatorStatement.astro";
import WhatsAppButton from "./ui/WhatsAppButton.astro";

import type { ServiceId } from "../data/services";
import { getHomeURL, locales, type Locale } from "../i18n/config";
import { getContent } from "../i18n/content";
import {
  getAbsoluteServiceURL,
  getServicePage,
  getServicePagesUI,
  getServiceURL,
  getServiceWhatsAppURL,
} from "../i18n/services";

interface Props {
  locale: Locale;
  id: ServiceId;
}

// Plantilla común de las páginas de servicio en todos los idiomas.
const { locale, id } = Astro.props;

const t = getContent(locale);
const ui = getServicePagesUI(locale);
const page = getServicePage(locale, id);

const homeURL = getHomeURL(locale);
const servicesURL = `${homeURL}#servicios`;
const whatsappURL = getServiceWhatsAppURL(locale, id);

// Página equivalente en cada idioma: selector de idioma y hreflang.
const languageURLs = Object.fromEntries(
  locales.map((option) => [option, getServiceURL(option, id)]),
) as Record<Locale, string>;

const alternateURLs = Object.fromEntries(
  locales.map((option) => [option, getAbsoluteServiceURL(option, id)]),
) as Record<Locale, string>;
---

<MainLayout
  locale={locale}
  title={page.seo.title}
  description={page.seo.description}
  alternateURLs={alternateURLs}
>
  <Header locale={locale} internalPage languageURLs={languageURLs} />

  <main id="main-content">
    <section class="service-hero" aria-labelledby="service-title">
      <div class="container">
        <nav class="breadcrumb" aria-label={ui.breadcrumbLabel}>
          <ol>
            <li>
              <a href={homeURL}>{t.header.navigation.inicio}</a>
            </li>
            <li>
              <a href={servicesURL}>{t.header.navigation.servicios}</a>
            </li>
            <li>
              <span aria-current="page">{page.name}</span>
            </li>
          </ol>
        </nav>

        <p class="section-label">{ui.heroLabel}</p>

        <h1 id="service-title">{page.title}</h1>

        <p class="service-intro">{page.intro}</p>

        <WhatsAppButton locale={locale} label={ui.ctaButton} href={whatsappURL} />
      </div>
    </section>

    <section class="section" aria-labelledby="about-title">
      <div class="container service-details">
        <div class="service-about">
          <h2 id="about-title" class="section-title">
            {ui.aboutTitle}
          </h2>

          <p>
            <TranslatorStatement locale={locale} />
          </p>
        </div>

        <div class="service-documents">
          <h2 id="documents-title">{ui.documentsTitle}</h2>

          <ul>
            {page.documents.map((document) => (
              <li>
                <span class="item-check">
                  <Icon name="check" size={16} />
                </span>
                {document}
              </li>
            ))}
          </ul>

          <p class="documents-note">{t.services.categories.other.description}</p>
        </div>
      </div>
    </section>

    <Process locale={locale} />

    <section class="section" aria-labelledby="service-cta-title">
      <div class="container">
        <div class="service-cta">
          <div>
            <h2 id="service-cta-title" class="cta-title">
              {t.services.ctaTitle}
            </h2>

            <p class="cta-text">{t.services.ctaText}</p>

            <p class="cta-note">{t.express.description}</p>
          </div>

          <WhatsAppButton locale={locale} label={ui.ctaButton} href={whatsappURL} />
        </div>

        <a class="back-link" href={servicesURL}>
          <span aria-hidden="true">←</span>
          {ui.backLink}
        </a>
      </div>
    </section>
  </main>

  <Footer locale={locale} />

  <FloatingWhatsApp locale={locale} />
</MainLayout>

<style>
  .service-hero {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 6vw, 4.5rem);

    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .breadcrumb ol {
    margin: 0;
    padding: 0;

    display: flex;
    flex-wrap: wrap;
    align-items: center;

    gap: 0 0.5rem;

    list-style: none;

    color: var(--color-text-muted);

    font-size: 0.9rem;
  }

  .breadcrumb li {
    display: inline-flex;
    align-items: center;

    gap: 0.5rem;
  }

  .breadcrumb li + li::before {
    content: "›" / "";

    color: var(--color-border-strong);
  }

  .breadcrumb a {
    min-height: 44px;

    display: inline-flex;
    align-items: center;

    color: var(--color-primary);

    font-weight: 600;

    text-underline-offset: 0.2em;
  }

  .breadcrumb [aria-current="page"] {
    color: var(--color-text);

    font-weight: 600;
  }

  h1 {
    max-width: 16em;

    margin: 0;

    color: var(--color-primary-hover);

    font-size: clamp(2rem, 4.4vw, 3rem);
    line-height: 1.12;

    letter-spacing: -0.02em;
  }

  .service-intro {
    max-width: 40rem;

    margin: 1.1rem 0 2rem;

    color: var(--color-text-muted);

    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.65;
  }

  .service-details {
    display: grid;

    grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);

    gap: clamp(2rem, 5vw, 4rem);

    align-items: start;
  }

  .service-about p {
    margin: 1rem 0 0;

    font-size: clamp(1.05rem, 1.6vw, 1.15rem);
    line-height: 1.7;
  }

  .service-documents {
    padding: clamp(1.5rem, 3vw, 2rem);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-lg);

    background: var(--color-surface);

    box-shadow: var(--shadow-sm);
  }

  .service-documents h2 {
    margin: 0;

    font-size: 1.3rem;
    line-height: 1.25;
  }

  .service-documents ul {
    margin: 1.25rem 0 0;
    padding: 1.25rem 0 0;

    display: grid;

    gap: 0.6rem;

    border-top: 1px solid var(--color-border);

    list-style: none;
  }

  .service-documents li {
    display: flex;
    align-items: flex-start;

    gap: 0.55rem;

    font-weight: 500;
    line-height: 1.45;
  }

  .item-check {
    margin-top: 0.1rem;

    color: var(--color-accent-strong);
  }

  .documents-note {
    margin: 1.25rem 0 0;

    color: var(--color-text-muted);

    font-size: 0.9rem;
    line-height: 1.6;
  }

  .service-cta {
    padding: clamp(1.5rem, 4vw, 2.25rem) clamp(1.5rem, 4vw, 2.5rem);

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;

    gap: 1.25rem 2rem;

    border: 1px solid var(--color-accent);

    border-radius: var(--radius-lg);

    background: var(--color-surface);

    box-shadow: var(--shadow-sm);
  }

  .service-cta > div {
    max-width: 38rem;
  }

  .service-cta p {
    margin: 0;
  }

  .cta-title {
    margin: 0;

    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    line-height: 1.3;
  }

  .service-cta .cta-text {
    margin-top: 0.35rem;

    color: var(--color-text-muted);
  }

  .service-cta .cta-note {
    margin-top: 0.75rem;

    color: var(--color-text-muted);

    font-size: 0.9rem;
    line-height: 1.6;
  }

  .back-link {
    min-height: 44px;

    margin-top: 1.5rem;

    display: inline-flex;
    align-items: center;

    gap: 0.5rem;

    color: var(--color-primary);

    font-weight: 650;

    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 900px) {
    .service-details {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .service-hero :global(.button),
    .service-cta :global(.button) {
      width: 100%;

      padding-inline: 1rem;
    }
  }
</style>
