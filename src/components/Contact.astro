---
import SectionHeader from "./ui/SectionHeader.astro";
import SocialLink from "./ui/SocialLink.astro";
import WhatsAppButton from "./ui/WhatsAppButton.astro";

import { contact } from "../data/contact";
---

<section id="contacto" class="section section-inverse contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div class="contact-main">
      <SectionHeader
        label="Contacto"
        title="Solicita tu cotización"
        titleId="contact-title"
        description="Envía tu documento por WhatsApp para recibir una cotización. También puedes escribir por correo electrónico o Instagram."
        variant="inverse"
        large
      />

      <WhatsAppButton label="Solicitar cotización por WhatsApp" variant="light" />
    </div>

    <aside class="contact-panel" aria-labelledby="contact-channels-title">
      <h3 id="contact-channels-title">Canales de contacto</h3>

      <div class="contact-links">
        <SocialLink
          label={contact.whatsapp.label}
          value={contact.whatsapp.display}
          href={contact.whatsapp.quoteURL}
          icon="whatsapp"
        />

        <SocialLink
          label={contact.email.label}
          value={contact.email.address}
          href={contact.email.url}
          icon="mail"
          external={false}
        />

        <SocialLink
          label={contact.instagram.label}
          value={contact.instagram.handle}
          href={contact.instagram.url}
          icon="instagram"
        />
      </div>
    </aside>
  </div>
</section>

<style>
  .contact {
    position: relative;

    overflow: hidden;

    background:
      radial-gradient(circle at 85% 15%, rgb(198 161 91 / 0.16), transparent 32%),
      radial-gradient(circle at 10% 100%, rgb(23 76 79 / 0.9), transparent 45%), var(--color-dark);
  }

  .contact-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(300px, 0.9fr);

    gap: clamp(3rem, 7vw, 6rem);

    align-items: center;
  }

  .contact-main {
    min-width: 0;
  }

  .contact-main :global(.section-header) {
    margin-bottom: 2.25rem;
  }

  .contact-panel {
    min-width: 0;

    padding: 1.5rem;

    border: 1px solid var(--color-border-inverse);

    border-radius: var(--radius-lg);

    background: rgb(16 54 56 / 0.6);

    box-shadow: 0 24px 60px rgb(0 0 0 / 0.18);
  }

  .contact-panel h3 {
    margin: 0 0 1.25rem;

    color: var(--color-text-inverse);

    font-size: 1.3rem;
  }

  .contact-links {
    display: grid;

    gap: 0.75rem;
  }

  @media (max-width: 850px) {
    .contact-grid {
      grid-template-columns: 1fr;

      gap: 2.5rem;
    }

    .contact-panel {
      max-width: 520px;
    }
  }

  @media (max-width: 600px) {
    .contact-main :global(.button) {
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .contact-panel {
      padding: 1rem;
    }
  }
</style>
