---
import SectionHeader from "./ui/SectionHeader.astro";
import SocialLink from "./ui/SocialLink.astro";
import WhatsAppButton from "./ui/WhatsAppButton.astro";

import { contact } from "../data/contact";
import { defaultLocale, type Locale } from "../i18n/config";
import { getContent, getWhatsAppURLs } from "../i18n/content";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;

const t = getContent(locale);

const whatsappURLs = getWhatsAppURLs(locale);
---

<section id="contacto" class="section section-inverse contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div class="contact-main">
      <SectionHeader
        label={t.contact.label}
        title={t.contact.title}
        titleId="contact-title"
        description={t.contact.description}
        variant="inverse"
        large
      />

      <WhatsAppButton locale={locale} label={t.contact.cta} variant="light" />
    </div>

    <div class="contact-panel">
      <h3 class="panel-title">{t.contact.channelsTitle}</h3>

      <ul class="contact-links">
        <li>
          <SocialLink
            locale={locale}
            label={contact.whatsapp.label}
            value={contact.whatsapp.display}
            href={whatsappURLs.quote}
            icon="whatsapp"
            featured
          />
        </li>

        <li>
          <SocialLink
            locale={locale}
            label={contact.email.label}
            value={contact.email.address}
            href={contact.email.url}
            icon="mail"
            external={false}
          />
        </li>

        <li>
          <SocialLink
            locale={locale}
            label={contact.instagram.label}
            value={contact.instagram.handle}
            href={contact.instagram.url}
            icon="instagram"
          />
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .contact {
    background:
      radial-gradient(circle at 12% 100%, var(--color-primary), transparent 50%), var(--color-dark);
  }

  .contact-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(300px, 440px);

    gap: clamp(2.5rem, 7vw, 6rem);

    align-items: center;
  }

  .contact-main {
    min-width: 0;
  }

  .contact-main :global(.section-header) {
    margin-bottom: 2rem;
  }

  .panel-title {
    margin: 0 0 1rem;

    color: var(--color-text-inverse-muted);

    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .contact-links {
    margin: 0;
    padding: 0;

    display: grid;

    gap: 0.75rem;

    list-style: none;
  }

  @media (max-width: 850px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-panel {
      max-width: 520px;
    }
  }

  @media (max-width: 600px) {
    .contact-main :global(.button) {
      width: 100%;
    }
  }
</style>
