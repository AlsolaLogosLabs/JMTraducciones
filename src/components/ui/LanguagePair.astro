---
import { defaultLocale, type Locale } from "../../i18n/config";
import { getContent } from "../../i18n/content";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;

const t = getContent(locale);

const { source, target } = t.profile.languages;

// Se muestra "Inglés ↔ Español" y se anuncia "Inglés y Español" a lectores de pantalla.
const accessibleLabel = t.a11y.languagePair(source, target);
---

<span class="language-pair">
  <span class="sr-only">{accessibleLabel}</span>
  <span aria-hidden="true">
    {source}
    <span class="arrow">↔</span>
    {target}
  </span>
</span>

<style>
  .language-pair {
    white-space: nowrap;
  }

  .arrow {
    margin-inline: 0.3em;

    color: var(--color-accent);

    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 400;
  }
</style>
