---
import Icon from "./Icon.astro";

import type { IconName } from "./icon-names";

interface Props {
  label: string;
  value: string;
  href: string;
  icon: IconName;
  external?: boolean;
  // Resalta el canal prioritario.
  featured?: boolean;
}

const { label, value, href, icon, external = true, featured = false } = Astro.props;

const accessibleLabel = [
  `${label}: ${value}.`,
  featured ? "Canal principal." : "",
  external ? "Abre en una pestaña nueva." : "",
]
  .filter(Boolean)
  .join(" ");
---

<a
  class:list={["social-link", { "social-link-featured": featured }]}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  aria-label={accessibleLabel}
>
  <span class="social-icon">
    <Icon name={icon} size={22} />
  </span>

  <span class="social-content">
    <span class="social-label">
      {label}
      {featured && <span class="social-badge">Canal principal</span>}
    </span>

    <strong>{value}</strong>
  </span>

  <svg
    class="social-arrow"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M7 17 17 7"></path>
    <path d="M7 7h10v10"></path>
  </svg>
</a>

<style>
  .social-link {
    min-height: 72px;

    padding: 0.9rem 1.1rem;

    display: flex;
    align-items: center;

    gap: 0.9rem;

    border: 1px solid var(--color-border-inverse);

    border-radius: var(--radius-md);

    color: var(--color-text-inverse);

    background: var(--color-surface-inverse);

    text-decoration: none;

    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .social-link-featured {
    min-height: 84px;

    border-color: var(--color-accent);

    background: var(--color-surface-inverse-hover);
  }

  .social-icon {
    width: 44px;
    height: 44px;

    flex: 0 0 44px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    color: var(--color-text-inverse-muted);

    background: var(--color-surface-inverse);
  }

  .social-link-featured .social-icon {
    color: var(--color-primary-hover);

    background: var(--color-accent);
  }

  .social-content {
    min-width: 0;

    flex: 1;

    display: grid;

    gap: 0.15rem;
  }

  .social-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    gap: 0.25rem 0.6rem;

    color: var(--color-text-inverse-subtle);

    font-size: 0.75rem;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .social-badge {
    padding: 0.05rem 0.45rem;

    border: 1px solid var(--color-accent);

    border-radius: 999px;

    color: var(--color-accent);

    font-size: 0.65rem;
    letter-spacing: 0.08em;
  }

  .social-content strong {
    font-size: 1rem;
    font-weight: 600;

    overflow-wrap: anywhere;
  }

  .social-link-featured strong {
    font-size: 1.15rem;
  }

  .social-arrow {
    width: 20px;
    height: 20px;

    flex: 0 0 20px;

    color: var(--color-text-inverse-subtle);

    transition: transform var(--transition-fast);
  }

  .social-link-featured .social-arrow {
    color: var(--color-accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .social-link:hover {
      border-color: var(--color-accent);

      background: var(--color-surface-inverse-hover);
    }

    .social-link:hover .social-arrow {
      transform: translate(2px, -2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-link:hover .social-arrow {
      transform: none;
    }
  }
</style>
