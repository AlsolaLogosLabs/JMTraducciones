---
import Icon from "./Icon.astro";

import { defaultLocale, type Locale } from "../../i18n/config";
import { getContent, getWhatsAppURLs } from "../../i18n/content";

interface Props {
  locale?: Locale;
  label: string;
  href?: string;
  variant?: "primary" | "secondary" | "light";
  class?: string;
}

const {
  locale = defaultLocale,
  label,
  href = getWhatsAppURLs(locale).quote,
  variant = "primary",
  class: className,
} = Astro.props;

const t = getContent(locale);
---

<a
  class:list={["button", `button-${variant}`, className]}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <Icon name="whatsapp" size={20} />
  <span>{label}</span>
  <span class="sr-only">{t.a11y.whatsappNewTab}</span>
</a>
