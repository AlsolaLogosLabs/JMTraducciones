---
import Seal from "./Seal.astro";
import LanguagePair from "./LanguagePair.astro";

import { profile } from "../../data/profile";

// Resumen visual de marca propia. Evita números, firmas o escudos para no parecer un documento oficial.
---

<aside class="credential-card" aria-label="Resumen de la credencial profesional">
  <Seal size={124} />

  <p class="card-role">{profile.role}</p>

  <p class="card-languages">
    <LanguagePair />
  </p>

  <p class="card-brand">{profile.brand}</p>
</aside>

<style>
  .credential-card {
    position: relative;

    padding: 2.5rem 2rem 2rem;

    display: flex;
    flex-direction: column;
    align-items: center;

    text-align: center;

    border: 1px solid var(--color-border);

    border-radius: var(--radius-lg);

    background: var(--color-surface);

    box-shadow: var(--shadow-lg);
  }

  /* Filete interior con estética documental. */
  .credential-card::before {
    content: "";

    position: absolute;

    inset: 0.6rem;

    border: 1px solid var(--color-accent-soft);

    border-radius: calc(var(--radius-lg) - 4px);

    pointer-events: none;
  }

  .card-role {
    margin: 1.5rem 0 0;

    color: var(--color-primary-hover);

    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .card-languages {
    margin: 0.4rem 0 0;

    color: var(--color-text-muted);

    font-weight: 600;
  }

  .card-brand {
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;

    width: 100%;

    border-top: 1px solid var(--color-border);

    color: var(--color-accent-strong);

    font-size: 0.75rem;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  @media (max-width: 420px) {
    .credential-card {
      padding: 2rem 1.35rem 1.5rem;
    }
  }
</style>
