---
interface Props {
  index: number;
  title: string;
  description: string;
}

const { index, title, description } = Astro.props;

const formattedIndex = String(index).padStart(2, "0");
---

<article class="step-card">
  <p class="step-index">
    <span class="sr-only">Paso</span>
    {formattedIndex}
  </p>

  <h3>{title}</h3>

  <p class="description">{description}</p>
</article>

<style>
  .step-card {
    height: 100%;

    padding: 1.75rem;

    border: 1px solid var(--color-border);

    border-radius: var(--radius-lg);

    background: var(--color-surface);

    box-shadow: var(--shadow-sm);
  }

  .step-index {
    margin: 0 0 1.5rem;

    width: 3rem;
    height: 3rem;

    display: grid;
    place-items: center;

    border: 1px solid var(--color-accent);

    border-radius: 50%;

    color: var(--color-primary);

    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
  }

  h3 {
    margin: 0;

    font-size: 1.25rem;
    line-height: 1.3;
  }

  .description {
    margin: 0.65rem 0 0;

    color: var(--color-text-muted);

    line-height: 1.65;
  }

  @media (max-width: 420px) {
    .step-card {
      padding: 1.5rem;
    }
  }
</style>
