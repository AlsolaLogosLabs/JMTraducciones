---
import { defaultLocale, type Locale } from "../../i18n/config";
import { getContent } from "../../i18n/content";

interface Props {
  locale?: Locale;
  index: number;
  title: string;
  description: string;
}

const { locale = defaultLocale, index, title, description } = Astro.props;

const t = getContent(locale);

const formattedIndex = String(index).padStart(2, "0");
---

<article class="step">
  <p class="step-index">
    <span class="sr-only">{t.a11y.step}</span>
    {formattedIndex}
  </p>

  <div class="step-content">
    <h3>{title}</h3>

    <p class="description">{description}</p>
  </div>
</article>

<style>
  .step {
    display: grid;

    gap: 1.25rem;
  }

  .step-index {
    position: relative;
    z-index: 1;

    margin: 0;

    width: 3rem;
    height: 3rem;

    display: grid;
    place-items: center;

    border: 1px solid var(--color-primary-border);

    border-radius: 50%;

    color: var(--color-primary);

    background: var(--color-surface);

    box-shadow: 0 0 0 6px var(--color-surface-alt);

    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
  }

  h3 {
    margin: 0;

    font-size: 1.2rem;
    line-height: 1.3;
  }

  .description {
    margin: 0.5rem 0 0;

    color: var(--color-text-muted);

    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* En móvil: número a la izquierda y contenido a la derecha. */
  @media (max-width: 800px) {
    .step {
      grid-template-columns: auto minmax(0, 1fr);

      gap: 1.1rem;
    }

    .step-content {
      padding-top: 0.6rem;
    }
  }
</style>
