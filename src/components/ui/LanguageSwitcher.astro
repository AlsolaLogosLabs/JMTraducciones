---
import { defaultLocale, getHomeURL, localeSettings, locales, type Locale } from "../../i18n/config";
import { getContent } from "../../i18n/content";

interface Props {
  locale?: Locale;
  class?: string;
}

const { locale = defaultLocale, class: className } = Astro.props;

const t = getContent(locale);

// Cambio manual de idioma: sin detección ni redirección automática.
---

<div class:list={["language-switcher", className]} role="group" aria-label={t.header.languageLabel}>
  {locales.map((option) => {
    const { name, shortName } = localeSettings[option];

    return option === locale ? (
      <span class="language-option is-current" lang={option} aria-current="true">
        <span aria-hidden="true">{shortName}</span>
        <span class="sr-only">{name}</span>
      </span>
    ) : (
      <a class="language-option" href={getHomeURL(option)} lang={option} hreflang={option}>
        <span aria-hidden="true">{shortName}</span>
        <span class="sr-only">{name}</span>
      </a>
    );
  })}
</div>

<style>
  .language-switcher {
    padding: 2px;

    display: inline-flex;
    align-items: center;

    flex-shrink: 0;

    border: 1px solid var(--color-border);

    border-radius: var(--radius-sm);

    background: var(--color-surface);
  }

  .language-option {
    min-width: 44px;
    min-height: 44px;

    display: inline-grid;
    place-items: center;

    border-radius: calc(var(--radius-sm) - 2px);

    color: var(--color-text-muted);

    font-size: 0.8rem;
    font-weight: 700;

    letter-spacing: 0.08em;

    text-decoration: none;

    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  a.language-option:hover {
    color: var(--color-primary);

    background: var(--color-primary-soft);
  }

  .language-option.is-current {
    color: var(--color-text-inverse);

    background: var(--color-primary);
  }
</style>
