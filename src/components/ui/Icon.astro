---
import type { IconName } from "./icon-names";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 26 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "civil" && (
    <g>
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
      <path d="M14 3v5h5" />
      <path d="M8.5 11.5h7" />
      <path d="M8.5 14.5h3" />
      <circle cx="15" cy="17" r="1.9" />
    </g>
  )}

  {name === "academic" && (
    <g>
      <path d="M2 9.5 12 5l10 4.5-10 4.5z" />
      <path d="M6 11.5V16c0 1.4 2.7 3 6 3s6-1.6 6-3v-4.5" />
      <path d="M22 9.5V15" />
    </g>
  )}

  {name === "technical" && (
    <g>
      <path d="M4 6h9" />
      <path d="M17 6h3" />
      <circle cx="15" cy="6" r="2" />
      <path d="M4 12h3" />
      <path d="M11 12h9" />
      <circle cx="9" cy="12" r="2" />
      <path d="M4 18h9" />
      <path d="M17 18h3" />
      <circle cx="15" cy="18" r="2" />
    </g>
  )}

  {name === "other" && (
    <g>
      <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
      <path d="M12 10.5v5" />
      <path d="M9.5 13h5" />
    </g>
  )}

  {name === "check" && <path d="m5 12.5 4.5 4.5L19 7.5" />}

  {name === "clock" && (
    <g>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </g>
  )}

  {name === "whatsapp" && (
    <g>
      <path d="M20.5 12a8.5 8.5 0 0 1-12.6 7.44L3.5 20.5l1.1-4.2A8.5 8.5 0 1 1 20.5 12z" />
      <path
        d="M9.2 8.6c.2-.4.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.7l-.5.6c.5 1 1.3 1.8 2.3 2.3l.6-.5c.2-.2.5-.2.7-.1l1.6.7c.3.1.4.3.4.5v.5c0 .3-.2.6-.5.8-.6.3-1.3.4-2 .2-2.2-.7-4-2.5-4.7-4.7-.2-.7-.1-1.4.2-2z"
        stroke-width="1.3"
      />
    </g>
  )}

  {name === "mail" && (
    <g>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
    </g>
  )}

  {name === "instagram" && (
    <g>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r="0.8" fill="currentColor" stroke="none" />
    </g>
  )}
</svg>

<style>
  .icon {
    display: block;

    flex-shrink: 0;
  }
</style>
