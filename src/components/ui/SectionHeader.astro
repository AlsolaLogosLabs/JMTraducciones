---
interface Props {
  label: string;
  title: string;
  description?: string;
  titleId: string;
  variant?: "default" | "inverse";
  large?: boolean;
}

const { label, title, description, titleId, variant = "default", large = false } = Astro.props;
---

<header
  class:list={[
    "section-header",
    {
      "section-header-inverse": variant === "inverse",

      "section-header-large": large,
    },
  ]}
>
  <p class="section-label">{label}</p>

  <h2 id={titleId} class="section-title">
    {title}
  </h2>

  {description && <p class="section-description">{description}</p>}
</header>

<style>
  .section-header-inverse .section-label {
    color: var(--color-accent);
  }

  .section-header-inverse .section-title {
    color: var(--color-text-inverse);
  }

  .section-header-inverse .section-description {
    color: var(--color-text-inverse-muted);
  }

  .section-header-large .section-title {
    font-size: clamp(2.3rem, 6vw, 3.6rem);
  }
</style>
