---
import Icon from "./ui/Icon.astro";
import WhatsAppButton from "./ui/WhatsAppButton.astro";

import { defaultLocale, type Locale } from "../i18n/config";
import { getContent, getWhatsAppURLs } from "../i18n/content";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;

const t = getContent(locale);
---

<section id="express" class="section express" aria-labelledby="express-title">
  <div class="container">
    <div class="express-card">
      <div class="express-badge" aria-hidden="true">
        <Icon name="clock" size={20} />
        <span class="badge-value">24 h</span>
      </div>

      <div class="express-content">
        <p class="section-label">{t.express.label}</p>

        <h2 id="express-title">{t.express.title}</h2>

        <p class="express-description">{t.express.description}</p>
      </div>

      <WhatsAppButton
        locale={locale}
        label={t.express.cta}
        href={getWhatsAppURLs(locale).express}
        class="express-cta"
      />
    </div>
  </div>
</section>

<style>
  /* Bloque secundario: menos aire vertical que una sección completa. */
  .express {
    padding-block: calc(var(--space-section) * 0.75);
  }

  .express-card {
    padding: clamp(1.5rem, 4vw, 2.25rem) clamp(1.5rem, 4vw, 2.5rem);

    display: grid;

    grid-template-columns: auto minmax(0, 1fr) auto;

    gap: clamp(1.25rem, 3vw, 2.25rem);

    align-items: center;

    border: 1px solid var(--color-accent);

    border-radius: var(--radius-lg);

    background: var(--color-surface);

    box-shadow: var(--shadow-sm);
  }

  .express-badge {
    width: 96px;
    height: 96px;

    display: grid;
    place-items: center;
    align-content: center;

    gap: 0.15rem;

    border-radius: 50%;

    color: var(--color-accent);

    background: var(--color-primary);

    box-shadow:
      0 0 0 5px var(--color-surface),
      0 0 0 6px var(--color-accent);
  }

  .badge-value {
    color: var(--color-text-inverse);

    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
  }

  .express-content .section-label {
    margin-bottom: 0.5rem;
  }

  h2 {
    margin: 0;

    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    line-height: 1.2;
  }

  .express-description {
    max-width: 36rem;

    margin: 0.6rem 0 0;

    color: var(--color-text-muted);

    line-height: 1.65;
  }

  @media (max-width: 960px) {
    .express-card {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .express-card :global(.express-cta) {
      grid-column: 2;

      justify-self: start;
    }
  }

  @media (max-width: 600px) {
    .express-card {
      grid-template-columns: 1fr;
    }

    .express-badge {
      width: 72px;
      height: 72px;
    }

    .badge-value {
      font-size: 1.2rem;
    }

    .express-card :global(.express-cta) {
      grid-column: auto;

      width: 100%;
    }
  }
</style>
