---
import SectionHeader from "./ui/SectionHeader.astro";
import ServiceCard from "./ui/ServiceCard.astro";
import WhatsAppButton from "./ui/WhatsAppButton.astro";

import { serviceCategories } from "../data/services";
import { defaultLocale, type Locale } from "../i18n/config";
import { getContent } from "../i18n/content";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;

const t = getContent(locale);
---

<section id="servicios" class="section section-alt" aria-labelledby="services-title">
  <div class="container">
    <SectionHeader
      label={t.services.label}
      title={t.services.title}
      titleId="services-title"
      description={t.services.summary}
    />

    <div class="services-grid">
      {serviceCategories.map((category) => {
        const text = t.services.categories[category.id];

        return (
          <ServiceCard
            locale={locale}
            title={text.title}
            description={text.description}
            icon={category.icon}
            items={text.items}
          />
        );
      })}
    </div>

    <div class="services-cta">
      <div>
        <p class="cta-title">{t.services.ctaTitle}</p>

        <p class="cta-text">{t.services.ctaText}</p>
      </div>

      <WhatsAppButton locale={locale} label={t.services.ctaButton} variant="secondary" />
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;

    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));

    gap: 1.25rem;
  }

  /* Transición comercial discreta: una fila, no un segundo Hero. */
  .services-cta {
    margin-top: 2.5rem;
    padding-top: 2rem;

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;

    gap: 1rem 2rem;

    border-top: 1px solid var(--color-border);
  }

  .services-cta p {
    margin: 0;
  }

  .cta-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .cta-text {
    margin-top: 0.2rem;

    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .services-cta :global(.button) {
      width: 100%;
    }
  }
</style>
