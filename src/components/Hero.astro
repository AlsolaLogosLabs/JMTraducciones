---
import Icon from "./ui/Icon.astro";
import LanguagePair from "./ui/LanguagePair.astro";
import Seal from "./ui/Seal.astro";
import WhatsAppButton from "./ui/WhatsAppButton.astro";

import { profile } from "../data/profile";

// Datos de confianza complementarios: no repiten lo que ya dicen el título y el bloque profesional.
const trustItems = [
  "Cotización antes de iniciar",
  "Servicio express bajo consulta",
  `Reconocimiento del ${profile.authority}`,
];
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="hero-grid container">
    <div class="hero-content">
      <h1 id="hero-title">
        Traducciones certificadas
        <span class="title-languages">
          <LanguagePair />
        </span>
        en {profile.location}
      </h1>

      <p class="description">{profile.serviceSummary}</p>

      <div class="translator">
        <p class="translator-name">{profile.name}</p>

        <p class="translator-role">
          {profile.role}
          <span class="translator-divider" aria-hidden="true">
            ·
          </span>
          Idoneidad desde {profile.authorizedSince}
        </p>
      </div>

      <div class="actions">
        <WhatsAppButton label="Cotizar por WhatsApp" />

        <a class="button button-secondary" href="#servicios">
          Ver servicios
        </a>
      </div>

      <ul class="trust" aria-label="Información del servicio">
        {trustItems.map((item) => (
          <li>
            <Icon name="check" size={18} />
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="sheet sheet-source">
        <span class="sheet-tag">EN</span>

        <div class="sheet-lines">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <div class="sheet sheet-target">
        <span class="sheet-tag sheet-tag-target">ES</span>

        <div class="sheet-lines">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <span class="visual-arrow">↔</span>

      <div class="visual-seal">
        <Seal size={104} decorative />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;

    /* Ocupa la pantalla, con un tope para monitores muy altos. */
    min-height: min(calc(100svh - var(--header-height)), 760px);

    display: flex;
    align-items: center;

    overflow: hidden;

    background:
      radial-gradient(circle at 90% 10%, var(--color-accent-tint), transparent 36%),
      var(--color-background);
  }

  .hero-grid {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(300px, 380px);

    gap: clamp(3rem, 6vw, 5rem);

    align-items: center;
  }

  .hero-content {
    min-width: 0;
    max-width: 660px;
  }

  h1 {
    margin: 0;

    color: var(--color-primary-hover);

    font-size: clamp(2.25rem, 4.8vw, 3.5rem);
    line-height: 1.1;

    letter-spacing: -0.02em;
  }

  .title-languages {
    display: block;

    color: var(--color-primary);

    font-style: italic;
  }

  .description {
    max-width: 34rem;

    margin: 1.25rem 0 0;

    color: var(--color-text-muted);

    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.65;
  }

  /* Respaldo profesional: quién firma las traducciones. */
  .translator {
    margin-top: 1.75rem;
    padding-left: 1rem;

    border-left: 2px solid var(--color-accent);
  }

  .translator p {
    margin: 0;
  }

  .translator-name {
    font-weight: 650;
  }

  .translator-role {
    color: var(--color-text-muted);

    font-size: 0.95rem;
  }

  .translator-divider {
    margin-inline: 0.35rem;
  }

  .actions {
    margin-top: 2rem;

    display: flex;
    flex-wrap: wrap;

    gap: 0.75rem;
  }

  .trust {
    margin: 2.25rem 0 0;
    padding: 0;

    display: flex;
    flex-wrap: wrap;

    gap: 0.5rem 1.5rem;

    list-style: none;
  }

  .trust li {
    display: inline-flex;
    align-items: center;

    gap: 0.45rem;

    color: var(--color-text-muted);

    font-size: 0.9rem;
    font-weight: 600;
  }

  .trust li :global(.icon) {
    color: var(--color-accent-strong);
  }

  /* Ilustración abstracta: documento de origen y traducción. No representa un documento real. */
  .hero-visual {
    position: relative;

    width: 100%;

    aspect-ratio: 10 / 11;
  }

  .sheet {
    position: absolute;

    padding: 1.5rem 1.35rem;

    border: 1px solid var(--color-border);

    border-radius: var(--radius-md);

    background: var(--color-surface);
  }

  .sheet-source {
    top: 0;
    left: 0;

    width: 62%;
    height: 62%;

    background: var(--color-surface-alt);

    transform: rotate(-4deg);
  }

  .sheet-target {
    right: 0;
    bottom: 0;

    width: 72%;
    height: 74%;

    box-shadow: var(--shadow-lg);
  }

  .sheet-tag {
    padding: 0.2rem 0.55rem;

    display: inline-block;

    border: 1px solid var(--color-border-strong);

    border-radius: var(--radius-sm);

    color: var(--color-text-muted);

    font-size: 0.75rem;
    font-weight: 700;

    letter-spacing: 0.12em;
  }

  .sheet-tag-target {
    border-color: var(--color-primary);

    color: var(--color-text-inverse);

    background: var(--color-primary);
  }

  .sheet-lines {
    margin-top: 1.35rem;

    display: grid;

    gap: 0.75rem;
  }

  .sheet-lines span {
    height: 6px;

    border-radius: 999px;

    background: var(--color-border);
  }

  .sheet-target .sheet-lines span {
    background: var(--color-primary-soft);
  }

  .sheet-lines span:nth-child(2n) {
    width: 84%;
  }

  .sheet-lines span:nth-child(3n) {
    width: 66%;
  }

  .visual-arrow {
    position: absolute;

    top: 38%;
    left: 20%;

    width: 48px;
    height: 48px;

    display: grid;
    place-items: center;

    border: 1px solid var(--color-border);

    border-radius: 50%;

    color: var(--color-accent-strong);

    background: var(--color-surface);

    box-shadow: var(--shadow-md);

    font-size: 1.35rem;
  }

  .visual-seal {
    position: absolute;

    right: -0.75rem;
    bottom: -1.25rem;

    filter: drop-shadow(var(--shadow-drop));

    transform: rotate(-8deg);
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    /* En pantallas estrechas se prioriza la lectura del mensaje. */
    .hero-visual {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .actions {
      flex-direction: column;
    }

    .trust {
      flex-direction: column;
    }
  }

  @media (max-width: 420px) {
    h1 {
      font-size: 2.05rem;
    }

    /* En pantallas muy estrechas se permite partir el par de idiomas. */
    .title-languages :global(.language-pair) {
      white-space: normal;
    }
  }
</style>
