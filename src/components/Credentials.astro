---
import CredentialCard from "./ui/CredentialCard.astro";
import LanguagePair from "./ui/LanguagePair.astro";
import SectionHeader from "./ui/SectionHeader.astro";

import { credentialFields } from "../data/credentials";
import { defaultLocale, type Locale } from "../i18n/config";
import { getContent } from "../i18n/content";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;

const t = getContent(locale);
---

<section id="credenciales" class="section" aria-labelledby="credentials-title">
  <div class="container credentials-grid">
    <div class="credentials-content">
      <SectionHeader
        label={t.credentials.label}
        title={t.profile.role}
        titleId="credentials-title"
      />

      <p class="intro">
        {`${t.credentials.introLead} ${t.profile.role} `}
        {t.profile.roleOriginal && (
          <>
            (<span lang="es">{t.profile.roleOriginal}</span>){" "}
          </>
        )}
        {`${t.credentials.introLanguagesPrefix} `}
        <LanguagePair locale={locale} />
        {t.credentials.introEnd}
      </p>

      <dl class="credential-list">
        {credentialFields.map((field) => (
          <div>
            <dt>{t.credentials.fields[field].label}</dt>

            <dd>{t.credentials.fields[field].value}</dd>
          </div>
        ))}
      </dl>

      <p class="disclaimer">{t.credentials.disclaimer}</p>
    </div>

    <CredentialCard locale={locale} />
  </div>
</section>

<style>
  .credentials-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(280px, 360px);

    gap: clamp(2.5rem, 6vw, 5rem);

    align-items: center;
  }

  .credentials-content {
    min-width: 0;
    max-width: 660px;
  }

  .credentials-content :global(.section-header) {
    margin-bottom: 1.25rem;
  }

  .intro {
    margin: 0;

    font-size: clamp(1.05rem, 1.6vw, 1.15rem);
    line-height: 1.7;
  }

  /* Filas tipo ficha documental: etiqueta y valor alineados, separados por filetes. */
  .credential-list {
    margin: 2rem 0 0;

    border-top: 1px solid var(--color-border);
  }

  .credential-list div {
    padding-block: 0.85rem;

    display: grid;

    grid-template-columns: 9.5rem minmax(0, 1fr);

    gap: 0.25rem 1rem;

    align-items: baseline;

    border-bottom: 1px solid var(--color-border);
  }

  .credential-list dt {
    color: var(--color-accent-strong);

    font-size: 0.75rem;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .credential-list dd {
    margin: 0;

    font-weight: 600;
    line-height: 1.45;
  }

  .disclaimer {
    margin: 1.25rem 0 0;

    color: var(--color-text-muted);

    font-size: 0.875rem;
    line-height: 1.6;
  }

  @media (max-width: 850px) {
    .credentials-grid {
      grid-template-columns: 1fr;
    }

    .credentials-grid :global(.credential-card) {
      width: 100%;
      max-width: 380px;
    }
  }

  @media (max-width: 480px) {
    .credential-list div {
      grid-template-columns: 1fr;
    }
  }
</style>
