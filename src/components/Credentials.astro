---
import CredentialCard from "./ui/CredentialCard.astro";
import LanguagePair from "./ui/LanguagePair.astro";
import SectionHeader from "./ui/SectionHeader.astro";

import { credentials, credentialsDisclaimer } from "../data/credentials";
import { profile } from "../data/profile";
---

<section id="credenciales" class="section" aria-labelledby="credentials-title">
  <div class="container credentials-grid">
    <div class="credentials-content">
      <SectionHeader
        label="Credenciales"
        title="Traductor Público Autorizado"
        titleId="credentials-title"
      />

      <p class="intro">
        {profile.name} fue reconocido por el {profile.authority} como {profile.role} de{" "}
        <LanguagePair />, con idoneidad desde {profile.authorizedSince}.
      </p>

      <dl class="credential-list">
        {credentials.map((credential) => (
          <div>
            <dt>{credential.label}</dt>

            <dd>{credential.value}</dd>
          </div>
        ))}
      </dl>

      <p class="disclaimer">{credentialsDisclaimer}</p>
    </div>

    <CredentialCard />
  </div>
</section>

<style>
  .credentials-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1.25fr)
      minmax(280px, 0.75fr);

    gap: clamp(2.5rem, 6vw, 5rem);

    align-items: center;
  }

  .credentials-content {
    min-width: 0;
  }

  .credentials-content :global(.section-header) {
    margin-bottom: 1.5rem;
  }

  .intro {
    margin: 0;

    max-width: 640px;

    font-size: 1.1rem;
    line-height: 1.8;
  }

  .credential-list {
    margin: 2rem 0 0;

    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 1px;

    overflow: hidden;

    border: 1px solid var(--color-border);

    border-radius: var(--radius-md);

    background: var(--color-border);
  }

  .credential-list div {
    padding: 1.1rem 1.25rem;

    background: var(--color-surface);
  }

  .credential-list dt {
    color: var(--color-accent-strong);

    font-size: 0.75rem;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .credential-list dd {
    margin: 0.3rem 0 0;

    font-weight: 600;
    line-height: 1.45;
  }

  .disclaimer {
    margin: 1.5rem 0 0;

    max-width: 640px;

    color: var(--color-text-muted);

    font-size: 0.875rem;
    line-height: 1.6;
  }

  @media (max-width: 850px) {
    .credentials-grid {
      grid-template-columns: 1fr;
    }

    .credentials-grid :global(.credential-card) {
      max-width: 420px;
    }
  }

  @media (max-width: 520px) {
    .credential-list {
      grid-template-columns: 1fr;
    }
  }
</style>
